      "removeDirectionMarks": false,
      "collapseWhitespace": false,
      "removeMarks": false,
      "foldFinalLetters": false,
      "normalizeQuotes": false,
      "stripPunctuation": false
    },
    "expected": "  א‎   ב\n"
  },
  {
    "name": "non-Hebrew characters are untouched",
    "input": " English  123  😀 ",
    "expected": "English 123 😀"
  },
  {
    "name": "empty input is empty",
    "input": "",
    "expected": ""
  },
  {
    "name": "Unicode niqqud is not removed in v1",
